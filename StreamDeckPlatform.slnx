    <Project Path="Plugins/Deck.Plugins.Twitch.Tests/Deck.Plugins.Twitch.Tests.csproj" />
    <Project Path="Plugins/Deck.Plugins.Twitch/Deck.Plugins.Twitch.csproj" />

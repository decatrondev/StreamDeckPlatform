<Solution>
  <Folder Name="/Clients/">
    <!-- Clients/WebDeck (Node) y Clients/MobileDeck (MAUI Blazor Hybrid, Android
         por ahora) quedan fuera del .slnx a propósito: no son proyectos .NET
         "normales" para el build de la solución — WebDeck no es .NET, y
         MobileDeck necesita el workload maui-android instalado (no todos los
         SO de CI lo tienen por default), se compila aparte en su propio paso
         de CI. MobileDeck.Core (la lógica compartida, sin Android) sí es una
         librería .NET común y entra acá como cualquier otra. -->
    <Project Path="Clients/MobileDeck.Core.Tests/MobileDeck.Core.Tests.csproj" />
    <Project Path="Clients/MobileDeck.Core/MobileDeck.Core.csproj" />
  </Folder>
  <Folder Name="/Api/">
    <Project Path="Api/Deck.Api.Tests/Deck.Api.Tests.csproj" />
    <Project Path="Api/Deck.Api/Deck.Api.csproj" />
  </Folder>
  <Folder Name="/Contracts/">
    <Project Path="Contracts/Deck.SDK/Deck.SDK.csproj" />
  </Folder>
  <Folder Name="/Core/">
    <Project Path="Core/Deck.Core.Tests.FakePlugin/Deck.Core.Tests.FakePlugin.csproj" />
    <Project Path="Core/Deck.Core.Tests/Deck.Core.Tests.csproj" />
    <Project Path="Core/Deck.Core/Deck.Core.csproj" />
  </Folder>
  <Folder Name="/Device/">
    <Project Path="Device/Deck.Device/Deck.Device.csproj" />
  </Folder>
  <Folder Name="/Plugins/">
    <Project Path="Plugins/Deck.Plugins.Discord.Tests/Deck.Plugins.Discord.Tests.csproj" />
    <Project Path="Plugins/Deck.Plugins.Discord/Deck.Plugins.Discord.csproj" />
    <Project Path="Plugins/Deck.Plugins.Obs.Tests/Deck.Plugins.Obs.Tests.csproj" />

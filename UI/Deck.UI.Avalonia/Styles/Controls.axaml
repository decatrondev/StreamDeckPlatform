<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Botón de titlebar propio (min/max/close) — sin chrome nativo de Windows. -->
  <Style Selector="Button.TitleBarButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkMutedBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.TitleBarButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FlowdeckSurfaceRaisedBrush}" />
  </Style>
  <Style Selector="Button.TitleBarButton.Close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FlowdeckDangerBrush}" />
  </Style>
  <Style Selector="Button.TitleBarButton:pointerover">
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkBrush}" />
  </Style>

  <!-- Ítem de navegación en el sidebar (perfiles). -->
  <Style Selector="ListBox.ProfileList ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkMutedBrush}" />
  </Style>
  <Style Selector="ListBox.ProfileList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FlowdeckSurfaceBrush}" />
  </Style>
  <Style Selector="ListBox.ProfileList ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkBrush}" />
  </Style>

  <!-- Tecla de la grilla — el elemento central de toda la interacción. -->
  <Style Selector="Button.DeckKey">
    <Setter Property="Background" Value="{StaticResource FlowdeckSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FlowdeckLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="Button.DeckKey:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource FlowdeckAccentLightBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkBrush}" />
  </Style>
  <Style Selector="Button.DeckKey.Assigned">
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkBrush}" />
  </Style>
  <Style Selector="Button.DeckKey.Folder">
    <Setter Property="BorderBrush" Value="{StaticResource FlowdeckAccent}" />
  </Style>

  <!-- Tecla reservada para volver — fondo relleno en vez de solo el borde,
       para que no se confunda ni con una tecla vacía ni con una carpeta. -->
  <Style Selector="Button.DeckKey.Back">
    <Setter Property="Background" Value="{StaticResource FlowdeckAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.DeckKey.Back:pointerover">
    <Setter Property="Background" Value="{StaticResource FlowdeckAccentLightBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Punto de estado del sidebar de categorías en Ajustes (●/○). -->
  <Style Selector="Ellipse.StatusDot">
    <Setter Property="Fill" Value="{StaticResource FlowdeckInkFaintBrush}" />
  </Style>
  <Style Selector="Ellipse.StatusDot.Connected">
    <Setter Property="Fill" Value="{StaticResource FlowdeckAccentBrush}" />
  </Style>

  <!-- Pill de estado junto al título de cada categoría en Ajustes — antes
       era una línea de texto suelta arriba del todo, se ve más intencional
       como badge que como un renglón más de texto plano. -->
  <Style Selector="Border.StatusPill">
    <Setter Property="Background" Value="{StaticResource FlowdeckSurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,3" />
    <!-- Sin esto, "conectado como {DisplayName}" (largo variable) empujaba
         el resto de la fila del header en vez de recortarse. -->
    <Setter Property="MaxWidth" Value="200" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.StatusPill.Connected">
    <Setter Property="Background" Value="#262563EB" />
  </Style>
  <Style Selector="TextBlock.StatusPillText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkMutedBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.StatusPill.Connected TextBlock.StatusPillText">
    <Setter Property="Foreground" Value="{StaticResource FlowdeckAccentLightBrush}" />
  </Style>

  <!-- Campos del diálogo de asignación. -->
  <Style Selector="TextBox.FlowdeckField, ComboBox.FlowdeckField, AutoCompleteBox.FlowdeckField">
    <Setter Property="Background" Value="{StaticResource FlowdeckGraphiteBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource FlowdeckLineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="Button.Primary">
    <Setter Property="Background" Value="{StaticResource FlowdeckAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FlowdeckAccentLightBrush}" />
  </Style>

  <Style Selector="Button.Secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource FlowdeckInkMutedBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,8" />
  </Style>

</Styles>

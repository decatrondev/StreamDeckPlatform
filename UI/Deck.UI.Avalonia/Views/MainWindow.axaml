<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deck.UI.Avalonia.ViewModels"
        xmlns:conv="using:Deck.UI.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
        x:Class="Deck.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/flowdeck.ico"
        Title="Flowdeck"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FlowdeckGraphiteBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="40,*">

        <!-- Titlebar propio: sin barra nativa de Windows/macOS/Linux. -->
        <Grid Grid.Row="0" Background="{StaticResource FlowdeckSurfaceBrush}"
              ColumnDefinitions="Auto,*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/flowdeck-logo.png" Width="22" Height="22" />
                <TextBlock Text="Flowdeck" Foreground="{StaticResource FlowdeckInkBrush}"
                           FontWeight="SemiBold" FontSize="19" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="TitleBarButton" Content="⚙" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Ajustes de plugins" />
                <Button Classes="TitleBarButton" Content="—" Click="OnMinimizeClick" />
                <Button Classes="TitleBarButton" Content="□" Click="OnMaximizeClick" />
                <Button Classes="TitleBarButton Close" Content="✕" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- Cuerpo: sidebar de perfiles + grilla de la página actual. -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" IsVisible="{Binding !IsSettingsPageOpen}">

            <Border Grid.Column="0" Background="{StaticResource FlowdeckGraphiteBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="PERFILES" FontSize="11"
                               Foreground="{StaticResource FlowdeckInkFaintBrush}"
                               Margin="8,4,0,8" />

                    <ListBox Classes="ProfileList" ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent"
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="24">

                <!-- Breadcrumb + volver -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
                    <Button Content="←" Classes="Secondary" Padding="10,4"
                            Command="{Binding NavigateBackCommand}" IsVisible="{Binding CanNavigateBack}" />
                    <ItemsControl ItemsSource="{Binding BreadcrumbNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource FlowdeckInkMutedBrush}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Feedback de la última ejecución -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource FlowdeckInkMutedBrush}"
                           FontFamily="Consolas,monospace" FontSize="12"
                           Margin="0,18,0,0" />

                <!-- Grilla de teclas -->
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CurrentPage.Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ButtonSlotViewModel">
                            <Button Classes="DeckKey" Classes.Assigned="{Binding IsAssigned}"
                                    Classes.Folder="{Binding IsFolder}"
                                    Classes.Back="{Binding IsBackButton}"
                                    Command="{Binding ActivateCommand}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Margin="5" MinHeight="72">
                                <Button.ContextMenu>
                                    <ContextMenu IsEnabled="{Binding IsAssigned}">
                                        <MenuItem Header="Editar" Command="{Binding EditCommand}" />
                                        <MenuItem Header="Quitar" Command="{Binding ClearCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid>
                                    <!-- Reservada para volver (fila 0/col 0 de cualquier carpeta) —
                                         estilo bien distinto, no se confunde con una tecla común. -->
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" IsVisible="{Binding IsBackButton}">
                                        <TextBlock Text="←" FontSize="26" HorizontalAlignment="Center" />
                                        <TextBlock Text="Volver" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Con ícono, ocupa toda la tecla y el label de texto no se
                                         pinta (estilo Stream Deck real) — sin ícono, el layout de
                                         siempre (glyph de estado + nombre). -->
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <StackPanel.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!HasIcon" />
                                                <Binding Path="!IsBackButton" />
                                            </MultiBinding>
                                        </StackPanel.IsVisible>
                                        <TextBlock Text="{Binding StatusGlyph}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource FlowdeckAccentLightBrush}" />
                                        <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="90" />
                                    </StackPanel>

                                    <Image Source="{Binding IconBitmap}" IsVisible="{Binding IconBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Stretch="Uniform" Margin="10" />
                                    <TextBlock Text="{Binding IconEmoji}" IsVisible="{Binding IconEmoji, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding StatusGlyph}" IsVisible="{Binding HasIcon}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                               Foreground="{StaticResource FlowdeckAccentLightBrush}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>

        <!-- Diálogo de asignación — overlay propio, nada de MessageBox nativo. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
                IsVisible="{Binding IsDialogOpen}">
            <Border Width="460" MaxHeight="560" Background="{StaticResource FlowdeckSurfaceBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="1"
                    CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ScrollViewer Padding="20">
                <StackPanel Spacing="12" DataContext="{Binding Dialog}" x:DataType="vm:AssignActionDialogViewModel">
                    <TextBlock Text="Asignar tecla" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource FlowdeckInkBrush}" />

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="Acción" GroupName="Mode"
                                         IsChecked="{Binding Mode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AssignMode.Action}}" />
                            <RadioButton Content="Carpeta" GroupName="Mode"
                                         IsChecked="{Binding Mode, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static vm:AssignMode.Folder}}" />
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" TextWrapping="Wrap">
                            <Run Text="Acción: dispara algo al tocarla. Carpeta: no ejecuta nada, te lleva a otra página de teclas (para agrupar, ej. todas las escenas de OBS juntas)." />
                        </TextBlock>
                    </StackPanel>

                    <!-- Todo lo específico de "Acción" (plugin/acción, sus parámetros)
                         va adentro de este único contenedor gateado por Mode — antes
                         PathOrUrl/Args/Fields se ocultaban solo según IsSystemAction,
                         nunca según el Mode, así que en Carpeta seguían apareciendo
                         campos de acción (confundía, parecía que la carpeta fuera una
                         acción de sistema sin completar). -->
                    <StackPanel Spacing="8" IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AssignMode.Action}}">
                        <ComboBox Classes="FlowdeckField" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailablePlugins}"
                                  SelectedItem="{Binding SelectedPlugin}" />
                        <ComboBox Classes="FlowdeckField" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailableActions}"
                                  SelectedItem="{Binding SelectedAction}" />

                        <TextBox Classes="FlowdeckField" Text="{Binding PathOrUrl}"
                                 PlaceholderText="{Binding SelectedAction.ParameterLabel}"
                                 IsVisible="{Binding IsSystemAction}" />

                        <TextBox Classes="FlowdeckField" PlaceholderText="Argumentos (opcional)" Text="{Binding Args}"
                                  IsVisible="{Binding IsSystemAction}" />

                        <TextBlock FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" TextWrapping="Wrap">
                            <Run Text="En cualquier campo de texto podés usar {dia}, {fecha}, {hora}, {categoria}, {titulo}, {viewers}, {ultimo_seguidor} — se completan solas al apretar la tecla." />
                        </TextBlock>

                        <!-- Formulario armado a partir del ParametersSchemaJson de la
                             acción elegida — reemplaza el JSON crudo que había antes. -->
                        <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding !IsSystemAction}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ParameterFieldViewModel">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />

                                        <TextBox Classes="FlowdeckField" Text="{Binding TextValue}"
                                                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ParameterFieldType.Text}}" />

                                        <!-- Sin NumericUpDown a propósito: hubiera necesitado un
                                             converter string<->decimal nuevo para un campo más;
                                             un TextBox simple alcanza, la validación numérica ya
                                             pasa igual al armar el JSON final (BuildParametersJson). -->
                                        <TextBox Classes="FlowdeckField" Text="{Binding TextValue}"
                                                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ParameterFieldType.Number}}" />

                                        <CheckBox Content="Activado" IsChecked="{Binding BoolValue}"
                                                  IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ParameterFieldType.Boolean}}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ParameterFieldType.Select}}">
                                            <ComboBox Classes="FlowdeckField" Width="300"
                                                      ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" />
                                            <TextBlock Text="Cargando…" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{StaticResource FlowdeckInkFaintBrush}"
                                                       IsVisible="{Binding IsLoadingOptions}" />
                                        </StackPanel>

                                        <!-- Autocomplete en vivo (ej. buscar categoría de Twitch por
                                             nombre) — a diferencia de Select, no trae la lista entera
                                             una sola vez: AsyncPopulator busca de nuevo por cada tipeo. -->
                                        <AutoCompleteBox Classes="FlowdeckField" Width="300" HorizontalAlignment="Left"
                                                          MinimumPrefixLength="2" FilterMode="None"
                                                          AsyncPopulator="{Binding Populator}"
                                                          SelectedItem="{Binding SelectedOption}"
                                                          PlaceholderText="Escribí para buscar…"
                                                          IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ParameterFieldType.Search}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBox Classes="FlowdeckField" PlaceholderText="Nombre de la tecla" Text="{Binding Label}" />

                    <!-- Ícono opcional — con ícono, la tecla lo muestra a pantalla
                         completa y no el nombre (ver DeckKey en la grilla). -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Ícono (opcional)" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="40" Height="40" CornerRadius="8"
                                    Background="{StaticResource FlowdeckGraphiteBrush}"
                                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding IconPreviewBitmap}" IsVisible="{Binding IconPreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" Stretch="Uniform" Margin="4" />
                                    <TextBlock Text="{Binding IconPreviewEmoji}" IsVisible="{Binding IconPreviewEmoji, Converter={x:Static ObjectConverters.IsNotNull}}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button Content="Elegir imagen…" Classes="Secondary" Click="OnPickIconClick" />
                            <Button Content="Quitar" Classes="Secondary" Command="{Binding ClearIconCommand}"
                                    IsVisible="{Binding HasIcon}" />
                        </StackPanel>
                        <!-- Los 12 emoji fijos van a mano en vez de un ItemsControl —
                             son pocos y constantes, evita el binding relativo al VM
                             padre desde dentro de un DataTemplate. -->
                        <WrapPanel>
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="🎤" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="🎤" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="📷" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="📷" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="⚙️" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="⚙️" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="💬" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="💬" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="▶️" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="▶️" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="⏹" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="⏹" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="📁" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="📁" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="🔗" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="🔗" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="🔊" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="🔊" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="💻" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="💻" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="🎵" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="🎵" />
                            <Button Classes="Secondary" FontSize="16" Padding="8" Margin="0,0,4,4" Content="🔔" Command="{Binding SelectBuiltInIconCommand}" CommandParameter="🔔" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Classes="Secondary" Command="{Binding CancelCommand}" />
                        <Button Content="Guardar" Classes="Primary" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
        </Border>

        <!-- Resultado de una acción con salida larga (ej. "Ejecutar comando")
             — la línea de estado de abajo de la grilla no tiene scroll ni
             wrap, así que un resultado largo quedaba cortado e ilegible. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
                IsVisible="{Binding IsResultDialogOpen}">
            <Border Width="480" MaxHeight="420" Background="{StaticResource FlowdeckSurfaceBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ResultDialogTitle}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource FlowdeckInkBrush}" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom" Content="Cerrar" Classes="Secondary" Command="{Binding CloseResultDialogCommand}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" />
                    <ScrollViewer>
                        <TextBlock Text="{Binding ResultDialogMessage}" TextWrapping="Wrap"
                                   FontFamily="Consolas,monospace" FontSize="12"
                                   Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- Página de Ajustes — mismo patrón de dos "páginas" turnándose la
             fila 1 que la grilla de teclas, no un overlay/modal.
             IsVisible se evalúa contra MainViewModel (DataContext heredado
             de la ventana) — el cambio de DataContext a Settings pasa recién
             al Grid de adentro, si no compiled bindings no encuentra
             IsSettingsPageOpen en SettingsPageViewModel. -->
        <Grid Grid.Row="1" IsVisible="{Binding IsSettingsPageOpen}">
        <Grid ColumnDefinitions="200,*"
              DataContext="{Binding Settings}" x:DataType="vm:SettingsPageViewModel">

            <Border Grid.Column="0" Background="{StaticResource FlowdeckGraphiteBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="AJUSTES" FontSize="11"
                               Foreground="{StaticResource FlowdeckInkFaintBrush}"
                               Margin="8,4,0,8" />

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding AppVersion}" FontSize="10"
                               Foreground="{StaticResource FlowdeckInkFaintBrush}"
                               Margin="8,8,0,0" />

                    <ListBox Classes="ProfileList" ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsCategoryViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="StatusDot" Classes.Connected="{Binding IsConnected}"
                                             Width="7" Height="7" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="24">

                <!-- Grid en vez de StackPanel horizontal: la píldora vive en su propia
                     columna a la derecha (con ancho máximo + recorte, ver Controls.axaml)
                     para que un "conectado como {DisplayName}" largo no empuje el título
                     ni el botón de volver. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18" VerticalAlignment="Center">
                    <Button Grid.Column="0" Content="←" Classes="Secondary" Padding="10,4"
                            Command="{Binding CloseCommand}" ToolTip.Tip="Volver a la grilla" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedCategory.Name}" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="12,0,12,0" Foreground="{StaticResource FlowdeckInkBrush}" />

                    <!-- Un solo pill de estado — SelectedCategory.IsConnected siempre
                         corresponde a la categoría visible, así que sirve para las 5. -->
                    <Border Grid.Column="2" Classes="StatusPill" Classes.Connected="{Binding SelectedCategory.IsConnected}"
                            IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=decatron}">
                        <TextBlock Classes="StatusPillText" Text="{Binding DecatronStatus}" />
                    </Border>
                    <Border Grid.Column="2" Classes="StatusPill" Classes.Connected="{Binding SelectedCategory.IsConnected}"
                            IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=obs}">
                        <TextBlock Classes="StatusPillText" Text="{Binding ObsStatus}" />
                    </Border>
                    <Border Grid.Column="2" Classes="StatusPill" Classes.Connected="{Binding SelectedCategory.IsConnected}"
                            IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=twitch}">
                        <TextBlock Classes="StatusPillText" Text="{Binding TwitchStatus}" />
                    </Border>
                    <Border Grid.Column="2" Classes="StatusPill" Classes.Connected="{Binding SelectedCategory.IsConnected}"
                            IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=spotify}">
                        <TextBlock Classes="StatusPillText" Text="{Binding SpotifyStatus}" />
                    </Border>
                    <Border Grid.Column="2" Classes="StatusPill" Classes.Connected="{Binding SelectedCategory.IsConnected}"
                            IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=discord}">
                        <TextBlock Classes="StatusPillText" Text="{Binding DiscordStatus}" />
                    </Border>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom" Text="{Binding FeedbackMessage}" FontSize="12"
                           Foreground="{StaticResource FlowdeckSignalBrush}" Margin="0,18,0,0" />

                <StackPanel Spacing="10" VerticalAlignment="Top">

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=decatron}">
                        <TextBlock Text="Iniciá sesión con tu cuenta de Decatron (usa tu Twitch) para identificarte en Flowdeck. Se abre el navegador."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420"
                                   IsVisible="{Binding !IsDecatronConnected}" />
                        <TextBlock Text="Tu cuenta de Flowdeck está vinculada a Decatron con tu Twitch. Si el acceso vence (dura una hora), se te va a pedir reautorizar con un click."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420"
                                   IsVisible="{Binding IsDecatronConnected}" />
                        <Button Content="Conectar con Decatron" Classes="Primary" Command="{Binding ConnectDecatronCommand}"
                                IsVisible="{Binding !IsDecatronConnected}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <Button Content="Desconectar" Classes="Secondary" Command="{Binding DisconnectDecatronCommand}"
                                IsVisible="{Binding IsDecatronConnected}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=obs}">
                        <TextBlock Text="Contraseña del servidor WebSocket de OBS (Herramientas → Configuración de WebSocket en OBS). Dejar vacío si no tiene."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420" />
                        <TextBox Classes="FlowdeckField" PasswordChar="•" Text="{Binding ObsPassword}"
                                  PlaceholderText="Contraseña de OBS WebSocket" Width="320" HorizontalAlignment="Left" Margin="0,4,0,0" />

                        <TextBlock Text="Host y puerto — solo hace falta tocarlos si OBS corre en otra PC de la red o si se cambió el puerto default (4455)."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Classes="FlowdeckField" Text="{Binding ObsHost}"
                                      PlaceholderText="127.0.0.1" Width="200" />
                            <TextBox Classes="FlowdeckField" Text="{Binding ObsPort}"
                                      PlaceholderText="4455" Width="100" />
                        </StackPanel>

                        <Button Content="Guardar y reconectar" Classes="Primary" Command="{Binding SaveObsCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=twitch}">
                        <TextBlock Text="Es un login aparte del de Decatron — Decatron solo identifica tu cuenta, esto autoriza a Flowdeck a cambiar título/categoría y mandar mensajes al chat en tu nombre."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420" />
                        <Button Content="Conectar con Twitch" Classes="Primary" Command="{Binding ConnectTwitchCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=spotify}">
                        <TextBlock Text="Autoriza a Flowdeck a controlar la reproducción (play/pause, siguiente, volumen)."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420" />
                        <Button Content="Conectar con Spotify" Classes="Primary" Command="{Binding ConnectSpotifyCommand}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                IsVisible="{Binding SelectedCategory.Id, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=discord}">
                        <TextBlock Text="Se conecta solo si Discord está abierto en esta máquina."
                                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FlowdeckInkMutedBrush}" MaxWidth="420" />
                    </StackPanel>

                </StackPanel>
            </DockPanel>
        </Grid>
        </Grid>

    </Grid>
</Window>

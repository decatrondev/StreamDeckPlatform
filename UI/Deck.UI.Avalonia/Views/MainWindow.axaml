<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Deck.UI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
        x:Class="Deck.UI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/flowdeck.ico"
        Title="Flowdeck"
        Width="960" Height="620" MinWidth="720" MinHeight="480"
        Background="{StaticResource FlowdeckGraphiteBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="40,*">

        <!-- Titlebar propio: sin barra nativa de Windows/macOS/Linux. -->
        <Grid Grid.Row="0" Background="{StaticResource FlowdeckSurfaceBrush}"
              ColumnDefinitions="Auto,*,Auto"
              PointerPressed="OnTitleBarPointerPressed">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="14,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{StaticResource FlowdeckAccentBrush}" />
                <TextBlock Text="Flowdeck" Foreground="{StaticResource FlowdeckInkBrush}"
                           FontWeight="SemiBold" FontSize="13" />
            </StackPanel>

            <Border Grid.Column="1" IsVisible="{Binding UpdateAvailableVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="#26F5A623"
                    CornerRadius="10" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource FlowdeckSignalBrush}" FontSize="11" FontWeight="Medium">
                    <Run Text="Actualización" /><Run Text=" v" /><Run Text="{Binding UpdateAvailableVersion}" /><Run Text=" lista — se instala al cerrar" />
                </TextBlock>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Classes="TitleBarButton" Content="⚙" Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="Ajustes de plugins" />
                <Button Classes="TitleBarButton" Content="—" Click="OnMinimizeClick" />
                <Button Classes="TitleBarButton" Content="□" Click="OnMaximizeClick" />
                <Button Classes="TitleBarButton Close" Content="✕" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- Cuerpo: sidebar de perfiles + grilla de la página actual. -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*">

            <Border Grid.Column="0" Background="{StaticResource FlowdeckGraphiteBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="PERFILES" FontSize="11"
                               Foreground="{StaticResource FlowdeckInkFaintBrush}"
                               Margin="8,4,0,8" />

                    <ListBox Classes="ProfileList" ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent"
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="24">

                <!-- Breadcrumb + volver -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
                    <Button Content="←" Classes="Secondary" Padding="10,4"
                            Command="{Binding NavigateBackCommand}" IsVisible="{Binding CanNavigateBack}" />
                    <ItemsControl ItemsSource="{Binding BreadcrumbNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource FlowdeckInkMutedBrush}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Feedback de la última ejecución -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource FlowdeckInkMutedBrush}"
                           FontFamily="Consolas,monospace" FontSize="12"
                           Margin="0,18,0,0" />

                <!-- Grilla de teclas -->
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding CurrentPage.Columns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ButtonSlotViewModel">
                            <Button Classes="DeckKey" Classes.Assigned="{Binding IsAssigned}"
                                    Classes.Folder="{Binding IsFolder}"
                                    Command="{Binding ActivateCommand}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Margin="5" MinHeight="72">
                                <Button.ContextMenu>
                                    <ContextMenu IsEnabled="{Binding IsAssigned}">
                                        <MenuItem Header="Editar" Command="{Binding EditCommand}" />
                                        <MenuItem Header="Quitar" Command="{Binding ClearCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusGlyph}" HorizontalAlignment="Center"
                                               Foreground="{StaticResource FlowdeckAccentLightBrush}" />
                                    <TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"
                                               TextAlignment="Center" MaxWidth="90" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>

        <!-- Diálogo de asignación — overlay propio, nada de MessageBox nativo. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
                IsVisible="{Binding IsDialogOpen}">
            <Border Width="380" Background="{StaticResource FlowdeckSurfaceBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12" DataContext="{Binding Dialog}" x:DataType="vm:AssignActionDialogViewModel">
                    <TextBlock Text="Asignar tecla" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource FlowdeckInkBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <RadioButton Content="Acción" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AssignMode.Action}}" />
                        <RadioButton Content="Carpeta" GroupName="Mode"
                                     IsChecked="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AssignMode.Folder}}" />
                    </StackPanel>

                    <ComboBox Classes="FlowdeckField" HorizontalAlignment="Stretch"
                              IsVisible="{Binding Mode, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:AssignMode.Action}}"
                              ItemsSource="{Binding AvailableActions}"
                              SelectedItem="{Binding SelectedAction}" />

                    <TextBox Classes="FlowdeckField" PlaceholderText="Nombre de la tecla" Text="{Binding Label}" />

                    <TextBox Classes="FlowdeckField" Text="{Binding PathOrUrl}"
                             PlaceholderText="{Binding SelectedAction.ParameterLabel}"
                             IsVisible="{Binding IsSystemAction}" />

                    <TextBox Classes="FlowdeckField" PlaceholderText="Argumentos (opcional)" Text="{Binding Args}"
                              IsVisible="{Binding IsSystemAction}" />

                    <!-- Plugins de terceros (OBS/Spotify/Discord/Twitch) todavía no
                         publican un ParametersSchemaJson por acción — hasta que lo
                         hagan, sus parámetros se escriben como JSON crudo acá. -->
                    <TextBox Classes="FlowdeckField" AcceptsReturn="True" Height="70"
                             PlaceholderText="{Binding SelectedAction.ParameterLabel}"
                             Text="{Binding RawParametersJson}"
                             IsVisible="{Binding !IsSystemAction}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Classes="Secondary" Command="{Binding CancelCommand}" />
                        <Button Content="Guardar" Classes="Primary" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Ajustes de plugins — overlay propio, mismo patrón que el diálogo de asignar. -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#B0000000"
                IsVisible="{Binding IsSettingsDialogOpen}">
            <Border Width="420" Background="{StaticResource FlowdeckSurfaceBrush}"
                    BorderBrush="{StaticResource FlowdeckLineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" DataContext="{Binding Settings}" x:DataType="vm:SettingsDialogViewModel">
                    <TextBlock Text="Ajustes de plugins" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource FlowdeckInkBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="Medium" Foreground="{StaticResource FlowdeckInkBrush}">
                            <Run Text="Cuenta Decatron — " /><Run Text="{Binding DecatronStatus}" Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="Iniciá sesión con tu cuenta de Decatron (usa tu Twitch) para identificarte en Flowdeck. Se abre el navegador."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />
                        <Button Content="Conectar con Decatron" Classes="Primary" Command="{Binding ConnectDecatronCommand}"
                                IsVisible="{Binding !IsDecatronConnected}" HorizontalAlignment="Left" />
                        <Button Content="Desconectar" Classes="Secondary" Command="{Binding DisconnectDecatronCommand}"
                                IsVisible="{Binding IsDecatronConnected}" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock FontWeight="Medium" Foreground="{StaticResource FlowdeckInkBrush}">
                            <Run Text="OBS Studio — " /><Run Text="{Binding ObsStatus}" Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="Contraseña del servidor WebSocket de OBS (Herramientas → Configuración de WebSocket en OBS). Dejar vacío si no tiene."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />
                        <TextBox Classes="FlowdeckField" PasswordChar="•" Text="{Binding ObsPassword}"
                                  PlaceholderText="Contraseña de OBS WebSocket" />
                        <Button Content="Guardar y reconectar" Classes="Primary" Command="{Binding SaveObsCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="Medium" Foreground="{StaticResource FlowdeckInkBrush}">
                            <Run Text="Discord — " /><Run Text="{Binding DiscordStatus}" Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="Se conecta solo si Discord está abierto en esta máquina."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="Medium" Foreground="{StaticResource FlowdeckInkBrush}">
                            <Run Text="Twitch — " /><Run Text="{Binding TwitchStatus}" Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                        </TextBlock>
                        <TextBlock FontWeight="Medium" Foreground="{StaticResource FlowdeckInkBrush}" Margin="0,4,0,0">
                            <Run Text="Spotify — " /><Run Text="{Binding SpotifyStatus}" Foreground="{StaticResource FlowdeckInkMutedBrush}" />
                        </TextBlock>
                        <TextBlock Text="El login de Twitch y Spotify todavía no está disponible desde la app — llega en la próxima actualización."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource FlowdeckInkFaintBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding FeedbackMessage}" FontSize="12"
                               Foreground="{StaticResource FlowdeckSignalBrush}" />

                    <Button Content="Cerrar" Classes="Secondary" Command="{Binding CloseCommand}"
                            HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>

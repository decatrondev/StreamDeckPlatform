<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- DeckApiFactory (Deck.Api.Tests) coordina el aislamiento de la base vía
         una variable de entorno global — tener más de una clase de test que
         la usa (DeckApiClientTests, DeckHubClientTests) exige que xUnit no
         las corra en paralelo entre sí, o se pisan la variable. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reusa el WebApplicationFactory real de Deck.Api.Tests en vez de armar
         un servidor falso propio — el "servidor real" acá es literalmente
         Deck.Api corriendo en memoria, mismo patrón que los plugins usan
         Fake*Server pero con la ventaja de que este backend ya existe. -->
    <ProjectReference Include="..\..\Api\Deck.Api.Tests\Deck.Api.Tests.csproj" />
    <ProjectReference Include="..\MobileDeck.Core\MobileDeck.Core.csproj" />
  </ItemGroup>

</Project>
